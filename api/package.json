{
  "name": "@cristiadu/rate-my-everything-api",
  "version": "1.0.0",
  "description": "Rate My Everything API",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "vite build",
    "dev": "vite",
    "deploy": "echo \"Deploy API\"",
    "release": "echo \"Release API\"",
    "pretest": "docker compose -f compose.yaml down -v && docker compose -f compose.yaml up -d --wait-timeout 100 && sleep 3",
    "test": "vitest run",
    "posttest": "docker compose -f compose.yaml down -v",
    "test:watch": "vitest",
    "test:coverage": "pnpm test --coverage",
    "lint": "eslint --ext .ts src/",
    "upgrade-dependencies": "pnpm up --latest",
    "openapi": "tsoa spec-and-routes",
    "postinstall": "pnpm openapi"
  },
  "author": "Cristiano Faustino",
  "license": "ISC",
  "dependencies": {
    "@tsoa/runtime": "7.0.0-alpha.0",
    "@types/bcrypt": "6.0.0",
    "bcrypt": "6.0.0",
    "body-parser": "2.3.0",
    "class-validator": "0.15.1",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.1.2",
    "pg": "8.23.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "tsoa": "7.0.0-alpha.0",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@types/body-parser": "1.19.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vite-plugin-node": "8.0.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}
