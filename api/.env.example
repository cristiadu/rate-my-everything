# Required for API authentication. Replace this with a random local-only value.
JWT_SECRET=replace-with-a-random-local-secret

# Optional: Last.fm import key. Create one at https://www.last.fm/api/account/create.
LASTFM_API_KEY=your-lastfm-api-key

# Optional: YouTube Data API v3 key from Google Cloud Console.
YOUTUBE_API_KEY=your-youtube-api-key

# Optional: lowest log level written (trace, debug, info, warn, error, fatal or silent). Defaults to info.
LOG_LEVEL=info

# Optional: set to true to create the admin below and the starter categories and attributes on start. Rows that already exist are kept. Defaults to false.
SEED_BOOTSTRAP_DATA=true

# Required when SEED_BOOTSTRAP_DATA is true: the first admin account. Local development values only; use your own in any shared environment.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-admin
